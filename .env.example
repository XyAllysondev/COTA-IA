# Crie uma cópia deste arquivo com o nome .env e informe a credencial do Mercado Pago.
# Nunca exponha este token no frontend ou em repositórios públicos.
MERCADO_PAGO_ACCESS_TOKEN=TEST-COLE_SEU_ACCESS_TOKEN_DE_TESTE_AQUI

# Token OAuth de uma aplicação do Mercado Livre, usado para consultar preços reais.
MERCADO_LIVRE_ACCESS_TOKEN=APP_USR-COLE_SEU_ACCESS_TOKEN_AQUI

# Chave gratuita do OpenRouter, usada como contingência se o Gemini atingir limite.
OPENROUTER_API_KEY=COLE_SUA_CHAVE_OPENROUTER_AQUI

# Chave gratuita da Groq, usada como último fallback da assistente.
GROQ_API_KEY=COLE_SUA_CHAVE_GROQ_AQUI

# URL pública do seu site, necessária para os redirecionamentos após o pagamento.
# Em desenvolvimento, deixe em branco; em produção use HTTPS.
APP_BASE_URL=https://seu-dominio.com
